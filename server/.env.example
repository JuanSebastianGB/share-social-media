# Server local environment — copy to `.env`
#   cp server/.env.example server/.env

# HTTP listen port (default 3000)
PORT=3000

# DynamoDB single-table name (must match CDK table in AWS)
TABLE_NAME=ShareSocialMedia

# DynamoDB endpoint:
#   memory  → in-process adapter (local/dev, no AWS needed)
#   http://127.0.0.1:8000 → DynamoDB Local
#   (empty) → real AWS DynamoDB using default credential chain
DYNAMODB_ENDPOINT=memory

# AWS region (DynamoDB + S3)
AWS_REGION=us-east-1

# Optional: only needed for local DynamoDB/S3 emulators (not for memory or IAM roles)
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

# Public base URL used when building app file URLs
PUBLIC_URL=http://localhost:3000

# JWT signing secret (required for auth)
JWT_SECRET=change-me-to-a-long-random-string

# Media (S3) — uploads for register / posts
#   MEDIA_ENDPOINT=memory → stub URLs, no AWS calls (good for local + tests)
MEDIA_ENDPOINT=memory
MEDIA_BUCKET=share-social-media-media
# Public URL prefix for objects (in AWS, CDK sets this to the CloudFront URL)
MEDIA_BASE_URL=https://media.local
