# Client local environment — copy to `.env`
#   cp client/.env.example client/.env

# API base URL (must match server PORT / PUBLIC_URL in local dev)
VITE_APP_BASE_URL=http://localhost:3000

# Optional: default storage file id used by some flows (same as server DEFAULT_IMAGE_ID)
# VITE_APP_DEFAULT_IMAGE_ID=63cf4d2242c5e33c105a87eb

# Cognito (optional). When ALL three are set, the SPA uses Cognito SignUp/SignIn
# + POST /auth/profile instead of /auth/register and /auth/login.
# Leave unset for local HS256 demo against a server without COGNITO_* env.
# VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_AWS_REGION=us-east-1

# Dev-only local preview: forms create a local session (no API/Cognito).
# Home/Profile open with empty feed and friends. Ignored in production builds.
# When set to true in DEV, wins over Cognito.
# VITE_LOCAL_PREVIEW=true
